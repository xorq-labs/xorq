# The root .gitignore is generated: .envrcs/.envrc.gitignore rebuilds it
# from this file, then the untracked .gitignore.local (your own rules), on
# every direnv load. Edit those two, never .gitignore. Unanchored, so it also
# keeps ignoring the nested, untracked .gitignore files tools write.
.gitignore
/.gitignore.local
/.gitignore.orig
/.gitignore.tmp.*
/target

.claude

# Byte-compiled / optimized / DLL files
__pycache__/
.pytest_cache/
*.py[cod]

# C extensions
*.so

