watch_file pyproject.toml

export direnv_root=$(pwd)

# Fragments run with PWD at .envrcs/ (source_env pushd's into them), so a
# layout dir resolved there would land in .envrcs/.direnv. Pin it once, at
# the root: a default that a direnvrc's own value overrides, then resolved
# and frozen so a $PWD-keyed direnv_layout_dir function is asked only here.
# Why each step: xorq-labs/xorq-envrcs .envrc.
direnv_layout_dir=${direnv_layout_dir:-$direnv_root/.direnv}
direnv_layout_dir=$(direnv_layout_dir)
direnv_layout_dir() { echo "$direnv_layout_dir"; }

source_env_if_exists .envrcs/.envrc.secrets
source_env_if_exists .envrcs/.envrc.user
