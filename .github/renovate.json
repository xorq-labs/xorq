{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rangeStrategy": "widen",
  "extends": [
    "config:recommended", ":disableDependencyDashboard", "group:all"
  ],
  "semanticCommits": "enabled",
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions",
    "pep621",
    "pre-commit"
  ],
  "prBodyTemplate": "{{{table}}}{{{notes}}}{{{warnings}}}{{{controls}}}",
  "packageRules": [
    {
      "matchManagers": ["pre-commit", "github-actions"],
      "rangeStrategy": "pin",
      "automerge": false
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "matchManagers": ["pep621"],
      "matchPackageNames": "dask",
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": "actions/setup-python",
      "enabled": false
    },
    {
      "matchUpdateTypes": ["pin", "pinDigest"],
      "enabled": false
    }
  ],
  "schedule": [
    "* 0-9 1 * *"
  ],
  "pre-commit": {
    "enabled": true
  },
  "prHourlyLimit": 5,
  "automerge": false,
  "printConfig": true
}